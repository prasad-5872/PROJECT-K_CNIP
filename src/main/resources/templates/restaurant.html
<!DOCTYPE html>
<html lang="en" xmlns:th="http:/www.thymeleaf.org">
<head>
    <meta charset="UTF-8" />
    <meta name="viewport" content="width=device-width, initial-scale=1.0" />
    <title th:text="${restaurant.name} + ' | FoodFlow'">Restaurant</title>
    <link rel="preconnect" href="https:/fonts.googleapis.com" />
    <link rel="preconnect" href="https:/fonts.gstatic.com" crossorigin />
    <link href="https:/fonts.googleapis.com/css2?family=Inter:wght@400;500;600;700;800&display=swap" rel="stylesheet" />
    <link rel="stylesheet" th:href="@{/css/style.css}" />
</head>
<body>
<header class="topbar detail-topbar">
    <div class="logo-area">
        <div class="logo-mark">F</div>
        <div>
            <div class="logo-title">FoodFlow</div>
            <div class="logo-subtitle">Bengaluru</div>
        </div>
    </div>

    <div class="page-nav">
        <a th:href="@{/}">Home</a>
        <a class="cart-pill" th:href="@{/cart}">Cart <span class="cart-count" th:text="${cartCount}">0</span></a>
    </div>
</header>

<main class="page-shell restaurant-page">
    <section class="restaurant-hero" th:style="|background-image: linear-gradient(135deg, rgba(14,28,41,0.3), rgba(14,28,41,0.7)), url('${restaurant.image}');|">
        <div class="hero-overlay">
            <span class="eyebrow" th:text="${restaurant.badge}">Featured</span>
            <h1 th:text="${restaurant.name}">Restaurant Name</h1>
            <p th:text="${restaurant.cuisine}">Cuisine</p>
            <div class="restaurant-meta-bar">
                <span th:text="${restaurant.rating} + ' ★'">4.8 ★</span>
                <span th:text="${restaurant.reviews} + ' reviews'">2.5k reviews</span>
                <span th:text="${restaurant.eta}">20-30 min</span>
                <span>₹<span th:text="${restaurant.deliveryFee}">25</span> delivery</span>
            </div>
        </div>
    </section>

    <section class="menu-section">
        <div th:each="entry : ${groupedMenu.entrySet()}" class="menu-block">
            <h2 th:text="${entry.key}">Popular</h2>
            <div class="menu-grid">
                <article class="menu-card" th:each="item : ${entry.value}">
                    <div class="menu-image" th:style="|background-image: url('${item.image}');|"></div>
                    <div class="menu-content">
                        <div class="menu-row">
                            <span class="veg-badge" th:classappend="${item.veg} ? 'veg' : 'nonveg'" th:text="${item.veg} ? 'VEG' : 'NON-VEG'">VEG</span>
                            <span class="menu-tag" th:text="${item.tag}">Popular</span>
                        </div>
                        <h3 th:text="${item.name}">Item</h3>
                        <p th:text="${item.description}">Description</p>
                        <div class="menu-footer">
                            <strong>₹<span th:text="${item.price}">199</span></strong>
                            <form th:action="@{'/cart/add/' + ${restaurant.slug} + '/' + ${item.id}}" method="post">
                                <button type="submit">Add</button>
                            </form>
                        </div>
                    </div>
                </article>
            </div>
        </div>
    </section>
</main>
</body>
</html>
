<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FoodFlow | Delivering happiness</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" th:href="@{/css/style.css}" />
</head>
<body>
<header class="topbar">
    <div class="logo-area">
        <div class="logo-mark">F</div>
        <div>
            <div class="logo-title">FoodFlow</div>
            <div class="logo-subtitle">Bengaluru</div>
        </div>
    </div>

    <div class="search-box">
        <input id="restaurantSearch" type="text" placeholder="Search for restaurants, dishes or cuisines" />
    </div>

    <nav class="nav-actions">
        <a href="#">Offers</a>
        <a href="#">Help</a>
        <a href="#">Sign in</a>
        <a class="cart-pill" th:href="@{/cart}">
            Cart
            <span class="cart-count" th:text="${cartCount}">0</span>
        </a>
    </nav>
</header>

<main class="page-shell">
    <section class="hero">
        <div class="hero-copy">
            <span class="eyebrow">Fast. Fresh. Delivered.</span>
            <h1>Craving something delicious tonight?</h1>
            <p>Discover local favorites from your neighborhood delivered to your doorstep in minutes.</p>
            <div class="hero-actions">
                <a class="primary-btn" href="#restaurants">Order now</a>
                <a class="secondary-btn" href="#popular">Explore</a>
            </div>
        </div>
        <div class="hero-visual">
            <div class="delivery-card">
                <div class="delivery-badge">Live</div>
                <div class="delivery-plate">
                    <div class="food-circle"></div>
                    <div class="food-circle small"></div>
                </div>
            </div>
        </div>
    </section>

    <section class="chip-row" id="popular">
        <span>Pizza</span>
        <span>Biryani</span>
        <span>Burger</span>
        <span>Healthy</span>
        <span>South Indian</span>
        <span>Desserts</span>
    </section>

    <section id="restaurants" class="restaurant-grid">
        <article class="restaurant-card" th:each="restaurant : ${restaurants}" th:attr="data-name=${restaurant.name} + ' ' + ${restaurant.cuisine}">
            <a th:href="@{'/restaurant/' + ${restaurant.slug}}">
                <div class="restaurant-cover" th:style="|background-image: url('${restaurant.image}');|"></div>
            </a>
            <div class="restaurant-body">
                <div class="card-header">
                    <h3 th:text="${restaurant.name}">Restaurant name</h3>
                    <span class="rating" th:text="${restaurant.rating} + ' ★'">4.8 ★</span>
                </div>
                <p class="cuisine" th:text="${restaurant.cuisine}">Cuisine</p>
                <div class="meta-row">
                    <span th:text="${restaurant.eta}">20-30 min</span>
                    <span th:text="${restaurant.badge}">Top rated</span>
                    <span>₹<span th:text="${restaurant.deliveryFee}">25</span> delivery</span>
                </div>
                <div class="card-footer">
                    <span class="review-count" th:text="${restaurant.reviews} + ' ratings'">2.1k ratings</span>
                    <a class="view-menu" th:href="@{'/restaurant/' + ${restaurant.slug}}">View menu</a>
                </div>
            </div>
        </article>
    </section>
</main>

<script th:src="@{/js/app.js}"></script>
</body>
</html>
