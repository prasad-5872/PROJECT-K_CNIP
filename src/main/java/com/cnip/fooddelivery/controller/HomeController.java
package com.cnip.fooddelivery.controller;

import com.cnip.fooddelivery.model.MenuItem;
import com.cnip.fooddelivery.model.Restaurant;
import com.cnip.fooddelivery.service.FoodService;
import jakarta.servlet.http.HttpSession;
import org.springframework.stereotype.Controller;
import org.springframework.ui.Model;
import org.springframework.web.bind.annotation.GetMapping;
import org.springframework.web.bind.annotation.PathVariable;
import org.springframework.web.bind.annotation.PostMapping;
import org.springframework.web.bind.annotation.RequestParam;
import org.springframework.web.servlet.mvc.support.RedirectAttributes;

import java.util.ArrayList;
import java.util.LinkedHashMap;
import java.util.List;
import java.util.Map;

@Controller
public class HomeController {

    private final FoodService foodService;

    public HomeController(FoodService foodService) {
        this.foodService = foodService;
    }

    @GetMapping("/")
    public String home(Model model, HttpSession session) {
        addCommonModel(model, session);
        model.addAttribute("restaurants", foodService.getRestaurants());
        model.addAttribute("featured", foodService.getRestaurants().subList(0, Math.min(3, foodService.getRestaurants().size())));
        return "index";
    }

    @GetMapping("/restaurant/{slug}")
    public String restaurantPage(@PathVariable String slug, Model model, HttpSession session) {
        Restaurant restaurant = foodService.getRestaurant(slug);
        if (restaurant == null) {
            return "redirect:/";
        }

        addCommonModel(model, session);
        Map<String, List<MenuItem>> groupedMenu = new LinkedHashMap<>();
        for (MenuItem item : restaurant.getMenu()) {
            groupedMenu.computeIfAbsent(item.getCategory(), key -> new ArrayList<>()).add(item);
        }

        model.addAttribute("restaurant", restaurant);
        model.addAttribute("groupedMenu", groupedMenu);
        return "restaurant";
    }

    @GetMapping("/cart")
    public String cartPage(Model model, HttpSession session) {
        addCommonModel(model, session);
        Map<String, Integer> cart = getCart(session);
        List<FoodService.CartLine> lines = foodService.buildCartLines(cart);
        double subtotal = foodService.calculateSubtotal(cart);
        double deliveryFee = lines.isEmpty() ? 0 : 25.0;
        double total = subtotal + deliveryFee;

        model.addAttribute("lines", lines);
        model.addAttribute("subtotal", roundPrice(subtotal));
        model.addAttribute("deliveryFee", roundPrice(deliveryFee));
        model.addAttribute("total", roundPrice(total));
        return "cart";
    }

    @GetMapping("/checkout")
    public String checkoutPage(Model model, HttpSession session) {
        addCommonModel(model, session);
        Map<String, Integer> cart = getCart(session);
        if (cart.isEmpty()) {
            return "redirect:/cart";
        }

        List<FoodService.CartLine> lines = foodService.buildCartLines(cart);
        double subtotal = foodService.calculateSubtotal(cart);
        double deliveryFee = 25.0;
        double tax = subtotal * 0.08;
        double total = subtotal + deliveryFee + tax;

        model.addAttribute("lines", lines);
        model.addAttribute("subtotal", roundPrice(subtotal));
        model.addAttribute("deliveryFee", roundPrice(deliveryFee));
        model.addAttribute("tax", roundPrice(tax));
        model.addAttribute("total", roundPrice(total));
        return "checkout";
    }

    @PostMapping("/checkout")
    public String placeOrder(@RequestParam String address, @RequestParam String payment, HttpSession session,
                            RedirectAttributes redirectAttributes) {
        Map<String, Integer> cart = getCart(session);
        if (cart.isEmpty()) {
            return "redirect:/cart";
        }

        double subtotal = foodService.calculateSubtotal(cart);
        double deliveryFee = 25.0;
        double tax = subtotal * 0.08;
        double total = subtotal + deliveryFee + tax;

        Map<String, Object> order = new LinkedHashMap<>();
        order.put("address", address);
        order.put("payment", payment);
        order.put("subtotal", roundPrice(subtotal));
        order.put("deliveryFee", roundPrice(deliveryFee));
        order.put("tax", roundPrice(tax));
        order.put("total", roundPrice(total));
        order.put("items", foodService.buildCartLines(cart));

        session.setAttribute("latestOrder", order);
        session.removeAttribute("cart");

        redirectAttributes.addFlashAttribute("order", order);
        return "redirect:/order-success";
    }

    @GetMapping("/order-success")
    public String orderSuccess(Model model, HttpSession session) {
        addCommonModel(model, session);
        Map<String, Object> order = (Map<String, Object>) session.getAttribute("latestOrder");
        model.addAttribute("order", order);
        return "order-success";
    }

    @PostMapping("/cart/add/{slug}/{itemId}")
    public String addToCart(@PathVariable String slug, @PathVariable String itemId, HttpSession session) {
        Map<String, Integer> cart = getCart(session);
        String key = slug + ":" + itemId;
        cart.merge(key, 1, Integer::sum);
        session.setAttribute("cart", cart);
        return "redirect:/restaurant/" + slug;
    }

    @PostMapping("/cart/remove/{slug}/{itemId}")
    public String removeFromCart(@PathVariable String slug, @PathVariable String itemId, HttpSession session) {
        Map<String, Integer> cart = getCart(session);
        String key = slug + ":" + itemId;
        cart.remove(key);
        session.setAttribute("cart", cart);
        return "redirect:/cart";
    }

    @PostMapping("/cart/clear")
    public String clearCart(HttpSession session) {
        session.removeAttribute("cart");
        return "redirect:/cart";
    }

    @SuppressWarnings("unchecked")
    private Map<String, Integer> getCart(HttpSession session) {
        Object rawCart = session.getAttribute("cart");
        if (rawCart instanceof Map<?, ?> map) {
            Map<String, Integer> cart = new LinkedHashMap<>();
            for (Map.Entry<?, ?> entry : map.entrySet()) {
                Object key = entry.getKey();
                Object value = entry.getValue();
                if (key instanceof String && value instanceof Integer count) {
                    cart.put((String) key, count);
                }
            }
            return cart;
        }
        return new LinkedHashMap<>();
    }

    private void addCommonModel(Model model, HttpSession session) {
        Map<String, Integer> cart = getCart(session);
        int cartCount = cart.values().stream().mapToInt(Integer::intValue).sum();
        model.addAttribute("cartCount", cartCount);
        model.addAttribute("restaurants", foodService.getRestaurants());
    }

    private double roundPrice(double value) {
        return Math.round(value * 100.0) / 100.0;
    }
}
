@Service
public class FoodService {

    private final List<Restaurant> restaurants = new ArrayList<>();
    private final Map<String, Restaurant> restaurantMap = new LinkedHashMap<>();
    private final Map<String, MenuItem> itemMap = new LinkedHashMap<>();

    public FoodService() {
        buildRestaurants();
    }

    public List<Restaurant> getRestaurants() {
        return restaurants;
    }

    public Restaurant getRestaurant(String slug) {
        return restaurantMap.get(slug);
    }

    public MenuItem getItemById(String itemId) {
        return itemMap.get(itemId);
    }

    public List<MenuItem> getMenuItems(String restaurantSlug) {
        Restaurant restaurant = restaurantMap.get(restaurantSlug);
        return restaurant == null ? List.of() : restaurant.getMenu();
    }

    public List<CartLine> buildCartLines(Map<String, Integer> cart) {
        List<CartLine> lines = new ArrayList<>();
        if (cart == null) {
            return lines;
        }

        for (Map.Entry<String, Integer> entry : cart.entrySet()) {
            String key = entry.getKey();
            int quantity = entry.getValue();
            if (quantity <= 0) {
                continue;
            }

            String[] parts = key.split(":", 2);
            if (parts.length != 2) {
                continue;
            }

            String restaurantSlug = parts[0];
            String itemId = parts[1];
            Restaurant restaurant = restaurantMap.get(restaurantSlug);
            MenuItem item = itemMap.get(itemId);
            if (restaurant == null || item == null) {
                continue;
            }
            lines.add(new CartLine(item, quantity, restaurantSlug, restaurant.getName()));
        }

        return lines;
    }

    public double calculateSubtotal(Map<String, Integer> cart) {
        return buildCartLines(cart).stream()
                .mapToDouble(line -> line.item().getPrice() * line.quantity())
                .sum();
    }

    public record CartLine(MenuItem item, int quantity, String restaurantSlug, String restaurantName) {
    }

